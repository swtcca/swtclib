{
  "name": "@swtc/serializer",
  "version": "1.2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Lospring Liu",
  "main": "cjs/index.js",
  "module": "esm/index.js",
  "types": "cjs/index.d.ts",
  "dependencies": {
    "@swtc/address-codec": "^1.2.0",
    "@swtc/common": "^1.2.0",
    "@swtc/keypairs": "^1.2.0",
    "@swtc/wallet": "^1.2.0",
    "bignumber.js": "^9.0.0",
    "bn-plus.js": "^1.0.0",
    "extend": "^3.0.2",
    "jsbn": "^1.1.0"
  },
  "description": "swtc serializer",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/node": "^20.0.0",
    "husky": "^9.0.0",
    "mocha": "^10.0.0",
    "prettier": "^3.0.0",
    "rollup": "^4.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.7.0"
  },
  "directories": {
    "lib": "lib"
  },
  "keywords": [
    "serializer",
    "swtc",
    "jingtum"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swtcca/swtclib.git"
  },
  "scripts": {
    "clean": "rm -fr esm cjs dist src lib package-lock.json node_modules",
    "prettier": "prettier",
    "pretty-quick": "pretty-quick",
    "prettier:check": "prettier -c tssrc/**/*.ts",
    "tsc": "tsc",
    "compile": "tsc -p tsconfig.lib.json; tsc -p tsconfig.cjs.json; tsc -p tsconfig.esm.json",
    "build": "rollup -c",
    "rollup": "rollup -c",
    "lint": "eslint tssrc/",
    "test": "tsc -p tsconfig.lib.json && mocha test/*.spec.js --exit --timeout 5000",
    "coveralls": "cat ./coverage/lcov.info | coveralls",
    "test:nyc": "tsc && nyc --extension=.ts --reporter=lcov --reporter=html --reporter=text mocha --timeout=3000 test/*.spec.js"
  },
  "bugs": {
    "url": "git+https://github.com/swtcca/swtclib.git"
  },
  "homepage": "https://github.com/swtcca/swtclib",
  "files": [
    "lib",
    "dist",
    "cjs",
    "esm"
  ]
}
