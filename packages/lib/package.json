{
  "name": "@swtc/lib",
  "version": "1.2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "websocket access for jingtum blockchain",
  "main": "cjs/index.js",
  "module": "esm/index.js",
  "types": "cjs/index.d.ts",
  "unpkg": "dist/swtc-lib.js",
  "jsdelivr": "dist/swtc-lib.js",
  "browser": {
    "swtc-tum3": false,
    "tum3-eth-abi": false,
    "ws": "./src/wswrapper.js"
  },
  "files": [
    "cjs",
    "esm",
    "dist"
  ],
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "clean": "rm -fr esm cjs dist src package-lock.json node_modules",
    "prettier": "prettier",
    "pretty-quick": "pretty-quick",
    "prettier:check": "prettier -c tssrc/*.ts",
    "prettier:tabs": "prettier --use-tabs --write package.json tssrc/*.ts",
    "tsc": "tsc",
    "mocha": "mocha",
    "compile": "tsc -p tsconfig.cjs.json; tsc -p tsconfig.esm.json",
    "build": "tsc; webpack",
    "rollup": "tsc; rollup -c",
    "lint": "eslint tssrc/",
    "test:guomi": "mocha \"test/guomi_test*.js\"",
    "test": "mocha \"test/test*.js\" --exit --timeout 5000",
    "test:api": "mocha \"test/api*.js\"",
    "test:guomiapi": "mocha \"test/guomi_api*.js\"",
    "test:nyc": "nyc --extension=.ts --reporter=html --reporter=text mocha test/test*.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swtcca/swtclib.git"
  },
  "keywords": [
    "swtc",
    "guomi",
    "jingtum",
    "account",
    "ledger",
    "remote"
  ],
  "author": "Lospring Liu <lospringliu@gmail.com>",
  "license": "BSD-2-Clause",
  "bugs": {
    "url": "git+https://github.com/swtcca/swtclib.git"
  },
  "homepage": "https://github.com/swtcca/swtclib",
  "dependencies": {
    "@swtc/address-codec": "^1.2.0",
    "@swtc/common": "^1.2.0",
    "@swtc/keypairs": "^1.2.0",
    "@swtc/serializer": "^1.2.0",
    "@swtc/transaction": "^1.2.0",
    "@swtc/utils": "^1.2.0",
    "@swtc/wallet": "^1.2.0",
    "lru-cache": "^11.3.5",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "axios": "^1.16.0",
    "chai": "^4.2.0",
    "chai-json-schema": "^1.5.1",
    "husky": "^9.0.0",
    "mocha": "^10.0.0",
    "prettier": "^3.0.0",
    "pretty-quick": "^4.0.0",
    "rollup": "^4.0.0",
    "sinon": "^21.1.2",
    "tslib": "^2.6.0",
    "typescript": "^5.7.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0"
  },
  "gitHead": "7e16cc86c0e36a72266eee05bdf87c60df761fa0"
}
