{
  "name": "@swtc/proxy",
  "version": "1.2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "rest api to jingtum blockchain",
  "keywords": [
    "rest",
    "api",
    "proxy",
    "jingtum"
  ],
  "author": "Lospring Liu <lospringliu@gmail.com>",
  "homepage": "https://github.com/swtcca/swtclib",
  "license": "BSD-2-Clause",
  "main": "src/index.js",
  "directories": {
    "src": "src",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swtcca/swtclib.git"
  },
  "scripts": {
    "clean": "rm -fr esm cjs dist src package-lock.json node_modules",
    "prettier": "prettier",
    "pretty-quick": "pretty-quick",
    "prettier:check": "prettier -c tssrc/**/*.ts",
    "prettier:tabs": "prettier --use-tabs --write tssrc/**/*.ts",
    "tsc": "tsc",
    "compile": "tsc",
    "lint": "eslint tssrc/",
    "build": "tsc",
    "start": "tsc; node start.js",
    "test": "tsc; jest --runInBand test/function.spec.js test/store.spec.js test/koa.spec.js test/multisign.spec.js",
    "test:api": "tsc; jest test/koa.spec.js",
    "test:multisign": "tsc; jest test/multisign.spec.js",
    "test:detect": "tsc; jest --detectOpenHandles",
    "test:coverage": "tsc; jest --coverage"
  },
  "bugs": {
    "url": "https://github.com/swtcca/swtclib/issues"
  },
  "dependencies": {
    "@koa/router": "^12.0.1",
    "@swtc/address-codec": "^1.2.0",
    "@swtc/common": "^1.2.0",
    "@swtc/keypairs": "^1.2.0",
    "@swtc/lib": "^1.2.0",
    "@swtc/serializer": "^1.2.0",
    "@swtc/transaction": "^1.2.0",
    "@swtc/utils": "^1.2.0",
    "@swtc/wallet": "^1.2.0",
    "@vue/runtime-core": "^3.5.0",
    "chalk": "^4.1.2",
    "koa": "^2.16.0",
    "koa-bodyparser": "^4.2.1",
    "koa-robots.txt": "^1.0.0",
    "koa-simple-qs": "^1.0.0",
    "koa-static": "^5.0.0",
    "koa2-request-log": "^1.0.1",
    "koa2-swagger-ui": "^5.12.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/koa-static": "^4.0.4",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "rollup": "^4.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.7.0"
  }
}
